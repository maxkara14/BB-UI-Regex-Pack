{
    "id": "9e186292-4c42-4f87-986c-5d6254f8fe8a",
    "scriptName": "[BB] scene state",
    "findRegex": "/::SCENE_STATE::\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\nConflict:\\s*(.*?)\\s*\\nChars:\\s*(.*?)\\s*\\nDetail:\\s*(.*?)\\s*\\nPlot:\\s*(.*?)\\s*\\nNext:\\s*(.*?)\\s*::SCENE_STATE_END::/g",
    "replaceString": "<style>\n.ss-wrap { background: rgba(20, 20, 25, 0.82); border: 1px solid rgba(255,255,255,0.1); border-left: 3px solid rgba(253, 224, 71, 0.6); border-radius: 6px 16px 16px 6px; margin: 24px 0; box-shadow: 0 8px 32px rgba(0,0,0,0.3); font-family: 'Georgia', serif; overflow: hidden; }\n.ss-clk { display: block; cursor: pointer; margin: 0; padding: 0; }\n.ss-header { display: flex; align-items: center; gap: 20px; padding: 12px 24px; flex-wrap: wrap; position: relative; user-select: none; transition: all 0.3s ease; }\n.ss-clk:hover .ss-header { background: rgba(255,255,255,0.03); }\n.ss-time { font-size: 1.8em; color: #f3f4f6; letter-spacing: 2px; font-weight: 300; text-shadow: 0 2px 10px rgba(255,255,255,0.2); }\n.ss-divider { width: 1px; height: 36px; background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.3), transparent); }\n.ss-info { display: flex; flex-direction: column; gap: 4px; }\n.ss-loc { font-size: 0.85em; font-weight: bold; color: #fde047; letter-spacing: 2px; text-transform: uppercase; }\n.ss-sub { font-size: 0.75em; color: #d1d5db; letter-spacing: 1.5px; opacity: 0.8; }\n.ss-dot { color: rgba(255,255,255,0.3); margin: 0 8px; }\n.ss-toggle { margin-left: auto; font-size: 0.7em; color: rgba(253,224,71,0.4); transition: transform 0.3s ease; }\n.ss-wrap:has(.ss-toggle-chk:checked) .ss-toggle { transform: rotate(180deg); }\n.ss-wrap:has(.ss-toggle-chk:checked) .ss-header { border-bottom: 1px solid rgba(255,255,255,0.08); }\n.ss-wrap:has(.ss-toggle-chk:checked) .ss-body { grid-template-rows: 1fr; opacity: 1; transform: translateY(0); }\n.ss-body { border-top: 1px solid rgba(255,255,255,0.08); display: grid; grid-template-rows: 0fr; opacity: 0; transform: translateY(-10px); transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }\n.ss-body-inner { overflow: hidden; display: flex; flex-direction: column; gap: 10px; padding: 0; }\n.ss-wrap:has(.ss-toggle-chk:checked) .ss-body-inner { padding: 12px 24px 16px; }\n.ss-label { font-size: 0.65em; text-transform: uppercase; letter-spacing: 2px; color: rgba(253,224,71,0.5); margin-bottom: 2px; }\n.ss-conflict { font-size: 0.8em; color: #fca5a5; font-style: italic; line-height: 1.4; }\n.ss-chars { font-size: 0.8em; color: #e5e7eb; line-height: 1.6; }\n.ss-detail { font-size: 0.8em; color: #e5e7eb; line-height: 1.4; }\n.ss-plot { font-size: 0.8em; color: #d1d5db; line-height: 1.4; }\n.ss-next { font-size: 0.75em; color: rgba(253,224,71,0.7); font-style: italic; line-height: 1.4; }\n</style>\n<div class=\"ss-wrap\"><label class=\"ss-clk\"><input type=\"checkbox\" class=\"ss-toggle-chk\" style=\"display:none;\"><div class=\"ss-header\"><div class=\"ss-time\">$5</div><div class=\"ss-divider\"></div><div class=\"ss-info\"><div class=\"ss-loc\">$3</div><div class=\"ss-sub\"><span>$1 ($2)</span><span class=\"ss-dot\">&#183;</span><span>$4</span></div></div><div class=\"ss-toggle\">&#9660;</div></div></label><div class=\"ss-body\"><div class=\"ss-body-inner\"><div><div class=\"ss-label\">&#9888; Conflict</div><div class=\"ss-conflict\">$6</div></div><div><div class=\"ss-label\">&#128101; Characters</div><div class=\"ss-chars\">$7</div></div><div><div class=\"ss-label\">&#128065; Detail</div><div class=\"ss-detail\">$8</div></div><div><div class=\"ss-label\">&#128214; Plot</div><div class=\"ss-plot\">$9</div></div><div><div class=\"ss-label\">&#10145; Next</div><div class=\"ss-next\">$10</div></div></div></div></div>",
    "trimStrings": [],
    "placement": [
        1,
        2,
        6
    ],
    "disabled": false,
    "markdownOnly": true,
    "promptOnly": false,
    "runOnEdit": true,
