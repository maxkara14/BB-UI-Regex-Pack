{
    "id": "4631ebe0-ac85-4525-a6ca-34a7a37243c7",
    "scriptName": "[BB] scene state (Dusty Rose Textured)",
    "findRegex": "/::SCENE_STATE::\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\nConflict:\\s*(.*?)\\s*\\nChars:\\s*(.*?)\\s*\\nDetail:\\s*(.*?)\\s*\\nPlot:\\s*(.*?)\\s*\\nNext:\\s*(.*?)\\s*::SCENE_STATE_END::/g",
    "replaceString": "<style>\n.ss-dr-wrap { background-color: #dfc8c8; background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E\"), linear-gradient(135deg, #EAD7D7 0%, #D4BEBE 100%); border: 1px solid #CFAEB5; border-radius: 12px; margin: 24px auto; box-shadow: inset 0 2px 3px rgba(255,255,255,0.5), 0 8px 20px rgba(110, 80, 85, 0.15); overflow: hidden; max-width: 100%; }\n.ss-dr-header { display: flex; align-items: center; gap: 16px; padding: 10px 20px; flex-wrap: wrap; justify-content: center; position: relative; }\n.ss-dr-time { font-family: Comfortaa, Comic Sans MS, cursive !important; font-size: 1.6em; color: #855160; letter-spacing: 1px; font-weight: 700; }\n.ss-dr-divider { width: 2px; height: 32px; background: #CFAEB5; border-radius: 2px; }\n.ss-dr-info { display: flex; flex-direction: column; gap: 4px; }\n.ss-dr-info, .ss-dr-info p, .ss-dr-info span, .ss-dr-info div, .ss-dr-info font { font-family: Nunito, Comic Sans MS, sans-serif !important; }\n.ss-dr-loc { font-size: 0.8em; font-weight: 700; color: #8C5968; letter-spacing: 1px; text-transform: uppercase; }\n.ss-dr-sub { font-size: 0.7em; color: #7A5B64; opacity: 0.9; font-weight: 600; }\n.ss-dr-dot { color: #CFAEB5; margin: 0 6px; font-size: 10px; }\n.ss-dr-toggle { margin-left: auto; font-size: 0.7em; color: #CFAEB5; transition: transform 0.3s ease; }\n.ss-dr-clk { display: block; cursor: pointer; margin: 0; padding: 0; user-select: none; }\n.ss-dr-clk:hover .ss-dr-header { background: rgba(255,255,255,0.03); }\n.ss-dr-wrap:has(.ss-dr-toggle-chk:checked) .ss-dr-toggle { transform: rotate(180deg); }\n.ss-dr-wrap:has(.ss-dr-toggle-chk:checked) .ss-dr-body { grid-template-rows: 1fr; opacity: 1; }\n.ss-dr-body { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease; font-family: Nunito, Comic Sans MS, sans-serif !important; }\n.ss-dr-body-inner { overflow: hidden; }\n.ss-dr-body-pad { display: flex; flex-direction: column; gap: 10px; padding: 12px 20px 16px; }\n.ss-dr-label { font-size: 0.65em; text-transform: uppercase; letter-spacing: 2px; color: #8C5968; opacity: 0.6; margin-bottom: 2px; font-weight: 700; }\n.ss-dr-conflict { font-size: 0.8em; color: #9B4D5A; font-style: italic; line-height: 1.4; }\n.ss-dr-chars { font-size: 0.8em; color: #5A3D47; line-height: 1.6; }\n.ss-dr-detail { font-size: 0.8em; color: #5A3D47; line-height: 1.4; }\n.ss-dr-plot { font-size: 0.8em; color: #7A5B64; line-height: 1.4; }\n.ss-dr-next { font-size: 0.75em; color: #8C5968; font-style: italic; line-height: 1.4; opacity: 0.8; }\n</style>\n<div class=\"ss-dr-wrap\">\n<label class=\"ss-dr-clk\"><input type=\"checkbox\" class=\"ss-dr-toggle-chk\" style=\"display:none;\">\n    <div class=\"ss-dr-header\">\n      <div class=\"ss-dr-time\">$5</div>\n      <div class=\"ss-dr-divider\"></div>\n      <div class=\"ss-dr-info\">\n        <div class=\"ss-dr-loc\">$3</div>\n        <div class=\"ss-dr-sub\">\n          <span>$1 ($2)</span><span class=\"ss-dr-dot\">✿</span><span>$4</span>\n        </div>\n      </div>\n      <div class=\"ss-dr-toggle\">▼</div>\n    </div>\n</label>\n  <div class=\"ss-dr-body\">\n    <div class=\"ss-dr-body-inner\"><div class=\"ss-dr-body-pad\">\n      <div><div class=\"ss-dr-label\">⚔ Conflict</div><div class=\"ss-dr-conflict\">$6</div></div>\n      <div><div class=\"ss-dr-label\">👤 Characters</div><div class=\"ss-dr-chars\">$7</div></div>\n      <div><div class=\"ss-dr-label\">🔍 Detail</div><div class=\"ss-dr-detail\">$8</div></div>\n      <div><div class=\"ss-dr-label\">📜 Plot</div><div class=\"ss-dr-plot\">$9</div></div>\n      <div><div class=\"ss-dr-label\">➡ Next</div><div class=\"ss-dr-next\">$10</div></div>\n    </div>\n    </div>\n  </div>\n</div>",
    "trimStrings": [],
    "placement": [
        1,
        2,
        6
    ],
    "disabled": false,
    "markdownOnly": true,
    "promptOnly": false,
    "runOnEdit": true,
    "substituteRegex": 0,
    "minDepth": null,
    "maxDepth": null
}