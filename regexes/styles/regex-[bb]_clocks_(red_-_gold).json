{
    "id": "72ae822a-735f-411f-9fd1-9e39ac50392c",
    "scriptName": "[BB] scene state (red - gold)",
    "findRegex": "/::SCENE_STATE::\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\nConflict:\\s*(.*?)\\s*\\nChars:\\s*(.*?)\\s*\\nDetail:\\s*(.*?)\\s*\\nPlot:\\s*(.*?)\\s*\\nNext:\\s*(.*?)\\s*::SCENE_STATE_END::/g",
    "replaceString": "<style>\n.ss-rg-wrap { background: linear-gradient(135deg, rgba(25, 15, 15, 0.7), rgba(10, 5, 5, 0.7)); border: 1px solid rgba(212, 175, 55, 0.2); border-left: 3px solid #d4af37; border-radius: 6px; margin: 20px 0; box-shadow: 0 4px 15px rgba(0,0,0,0.4), inset 0 0 10px rgba(212, 175, 55, 0.05); font-family: 'Georgia', serif; overflow: hidden; }\n.ss-rg-header { display: flex; align-items: center; gap: 16px; padding: 10px 18px; flex-wrap: wrap; position: relative; }\n.ss-rg-time { font-size: 1.6em; color: #fef08a; letter-spacing: 1px; text-shadow: 0 0 10px rgba(212, 175, 55, 0.4); }\n.ss-rg-divider { width: 1px; height: 32px; background: linear-gradient(to bottom, transparent, rgba(212, 175, 55, 0.5), transparent); }\n.ss-rg-info { display: flex; flex-direction: column; gap: 4px; }\n.ss-rg-loc { font-size: 0.85em; font-weight: bold; color: #fca5a5; letter-spacing: 1px; text-transform: uppercase; }\n.ss-rg-sub { font-size: 0.75em; color: #d1d5db; letter-spacing: 1px; }\n.ss-rg-dot { color: #d4af37; margin: 0 6px; }\n.ss-rg-toggle { margin-left: auto; font-size: 0.7em; color: rgba(212, 175, 55, 0.4); transition: transform 0.3s ease; }\n.ss-rg-clk { display: block; cursor: pointer; margin: 0; padding: 0; user-select: none; }\n.ss-rg-clk:hover .ss-rg-header { background: rgba(255,255,255,0.03); }\n.ss-rg-wrap:has(.ss-rg-toggle-chk:checked) .ss-rg-toggle { transform: rotate(180deg); }\n.ss-rg-wrap:has(.ss-rg-toggle-chk:checked) .ss-rg-body { grid-template-rows: 1fr; opacity: 1; transform: translateY(0); }\n.ss-rg-body { border-top: 1px solid rgba(212, 175, 55, 0.15); display: grid; grid-template-rows: 0fr; opacity: 0; transform: translateY(-10px); transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }\n.ss-rg-body-inner { overflow: hidden; display: flex; flex-direction: column; gap: 10px; padding: 0; }\n.ss-rg-wrap:has(.ss-rg-toggle-chk:checked) .ss-rg-body-inner { padding: 12px 18px 16px; }\n.ss-rg-label { font-size: 0.65em; text-transform: uppercase; letter-spacing: 2px; color: rgba(212, 175, 55, 0.5); margin-bottom: 2px; }\n.ss-rg-conflict { font-size: 0.8em; color: #fca5a5; font-style: italic; line-height: 1.4; }\n.ss-rg-chars { font-size: 0.8em; color: #e5e7eb; line-height: 1.6; }\n.ss-rg-detail { font-size: 0.8em; color: #e5e7eb; line-height: 1.4; }\n.ss-rg-plot { font-size: 0.8em; color: #d1d5db; line-height: 1.4; }\n.ss-rg-next { font-size: 0.75em; color: rgba(212, 175, 55, 0.7); font-style: italic; line-height: 1.4; }\n</style>\n<div class=\"ss-rg-wrap\">\n<label class=\"ss-rg-clk\"><input type=\"checkbox\" class=\"ss-rg-toggle-chk\" style=\"display:none;\">\n    <div class=\"ss-rg-header\">\n      <div class=\"ss-rg-time\">$5</div>\n      <div class=\"ss-rg-divider\"></div>\n      <div class=\"ss-rg-info\">\n        <span class=\"ss-rg-loc\">$3</span>\n        <div class=\"ss-rg-sub\">\n          <span>$1 ($2)</span> <span class=\"ss-rg-dot\">•</span> <span>$4</span>\n        </div>\n      </div>\n      <div class=\"ss-rg-toggle\">▼</div>\n    </div>\n</label>\n  <div class=\"ss-rg-body\">\n    <div class=\"ss-rg-body-inner\">\n      <div><div class=\"ss-rg-label\">⚔ Conflict</div><div class=\"ss-rg-conflict\">$6</div></div>\n      <div><div class=\"ss-rg-label\">👤 Characters</div><div class=\"ss-rg-chars\">$7</div></div>\n      <div><div class=\"ss-rg-label\">🔍 Detail</div><div class=\"ss-rg-detail\">$8</div></div>\n      <div><div class=\"ss-rg-label\">📜 Plot</div><div class=\"ss-rg-plot\">$9</div></div>\n      <div><div class=\"ss-rg-label\">➡ Next</div><div class=\"ss-rg-next\">$10</div></div>\n    </div>\n  </div>\n</div>",
