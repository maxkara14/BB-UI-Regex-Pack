orm:none;transition-delay:.09s}.s3-toggle:checked~.s3-content .s3-sigil{opacity:1;transform:none;transition-delay:.14s}.s3-toggle:checked~.s3-content .s3-title{opacity:1;transform:none;transition-delay:.18s}.s3-toggle:checked~.s3-content .s3-fragment{opacity:1;transform:none;transition-delay:.22s}.s3-toggle:checked~.s3-content .s3-close{opacity:.72;transform:none;transition-delay:.25s}.s3-rarity-Rare .s3-orb{width:114px;height:114px}.s3-rarity-Anomaly .s3-orb{width:118px;height:118px;box-shadow:0 0 20px var(--g),0 0 44px var(--a)}\n@media(max-width:560px){.s3-orb-wrap{max-width:100%;margin:16px auto}.s3-orb{width:92px;height:92px;box-shadow:0 0 14px var(--g),0 0 28px var(--a)}.s3-motes i:nth-child(2),.s3-motes i:nth-child(3){display:none}.s3-title{font-size:21px!important}.s3-fragment{font-size:14.5px;line-height:1.62}.s3-text.s3-len-Long .s3-fragment{max-height:270px}}\n@media(prefers-reduced-motion:reduce){.s3-stage,.s3-orb,.s3-halo,.s3-orb:after,.s3-core,.s3-motes i{animation:none!important}.s3-content,.s3-panel,.s3-sigil,.s3-title,.s3-fragment,.s3-close,.s3-orb{transition-duration:.01ms!important;transition-delay:0s!important}.s3-ring{display:none}}\n</style><div class='s3-orb-wrap s3-no-panel s3-rarity-$6' style='--a:$3;--b:$4;--g:$5;'><input id='s3-$1' class='s3-toggle' type='checkbox' autocomplete='off'><div class='s3-stage'><label for='s3-$1' class='s3-orb' title='Открыть отклик'><svg class='s3-halo' viewBox='0 0 126 126' aria-hidden='true'><circle cx='63' cy='63' r='62.5' fill='none' stroke='currentColor' stroke-width='1'/></svg><span class='s3-core'></span></label><span class='s3-ring'></span><span class='s3-ring s3-ring2'></span><span class='s3-motes'><i></i><i></i><i></i></span></div><div class='s3-content s3-text s3-len-$8'><div class='s3-reveal'><div class='s3-panel'><div class='s3-sigil'>$7 · $2</div><div class='s3-title'>$9</div><div class='s3-fragment'>$10</div><label for='s3-$1' class='s3-close' title='Свернуть'>×</label></div></div></div></div>",
