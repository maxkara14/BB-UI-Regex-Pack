    "findRegex": "/::SCENE_STATE::\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\nConflict:\\s*(.*?)\\s*\\nChars:\\s*(.*?)\\s*\\nDetail:\\s*(.*?)\\s*\\nPlot:\\s*(.*?)\\s*\\nNext:\\s*(.*?)\\s*::SCENE_STATE_END::/g",
    "replaceString": "<style>\n.ss-sv-wrap { background: linear-gradient(135deg, rgba(20, 25, 30, 0.8), rgba(10, 12, 15, 0.9)); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(148, 163, 184, 0.15); border-left: 3px solid #94a3b8; border-right: 3px solid #94a3b8; border-radius: 4px; margin: 24px 0; box-shadow: 0 4px 20px rgba(0,0,0,0.5), inset 0 0 15px rgba(148,163,184,0.05); font-family: 'Georgia', serif; position: relative; overflow: hidden; }\n.ss-sv-wrap::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 1px; background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.5), transparent); }\n.ss-sv-header { display: flex; align-items: center; gap: 20px; padding: 12px 18px; flex-wrap: wrap; position: relative; }\n.ss-sv-time { font-size: 1.8em; color: #f8fafc; letter-spacing: 2px; font-weight: 300; text-shadow: 0 0 10px rgba(255,255,255,0.2); }\n.ss-sv-divider { width: 1px; height: 36px; background: linear-gradient(to bottom, transparent, rgba(148,163,184,0.4), transparent); }\n.ss-sv-info { display: flex; flex-direction: column; gap: 4px; }\n.ss-sv-loc { font-size: 0.85em; font-weight: bold; color: #bae6fd; letter-spacing: 2px; text-transform: uppercase; }\n.ss-sv-date { font-size: 0.9em; color: #cbd5e1; opacity: 0.9; }\n.ss-sv-weather { font-size: 0.9em; color: #94a3b8; }\n.ss-sv-icon { font-size: 1.2em; filter: drop-shadow(0 0 4px rgba(186,230,253,0.4)); }\n.ss-sv-toggle { margin-left: auto; font-size: 0.7em; color: rgba(148, 163, 184, 0.4); transition: transform 0.3s ease; }\n.ss-sv-clk { display: block; cursor: pointer; margin: 0; padding: 0; user-select: none; }\n.ss-sv-clk:hover .ss-sv-header { background: rgba(255,255,255,0.03); }\n.ss-sv-wrap:has(.ss-sv-toggle-chk:checked) .ss-sv-toggle { transform: rotate(180deg); }\n.ss-sv-wrap:has(.ss-sv-toggle-chk:checked) .ss-sv-body { grid-template-rows: 1fr; opacity: 1; }\n.ss-sv-body { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease; }\n.ss-sv-body-inner { overflow: hidden; }\n.ss-sv-body-pad { display: flex; flex-direction: column; gap: 10px; padding: 12px 18px 16px; }\n.ss-sv-label { font-size: 0.65em; text-transform: uppercase; letter-spacing: 2px; color: rgba(148, 163, 184, 0.5); margin-bottom: 2px; }\n.ss-sv-conflict { font-size: 0.8em; color: #fca5a5; font-style: italic; line-height: 1.4; }\n.ss-sv-chars { font-size: 0.8em; color: #e2e8f0; line-height: 1.6; }\n.ss-sv-detail { font-size: 0.8em; color: #e2e8f0; line-height: 1.4; }\n.ss-sv-plot { font-size: 0.8em; color: #cbd5e1; line-height: 1.4; }\n.ss-sv-next { font-size: 0.75em; color: rgba(186, 230, 253, 0.7); font-style: italic; line-height: 1.4; }\n</style>\n<div class=\"ss-sv-wrap\">\n<label class=\"ss-sv-clk\"><input type=\"checkbox\" class=\"ss-sv-toggle-chk\" style=\"display:none;\">\n    <div class=\"ss-sv-header\">\n      <div class=\"ss-sv-time\">$5</div>\n      <div class=\"ss-sv-divider\"></div>\n      <div class=\"ss-sv-info\">\n        <div class=\"ss-sv-loc\">$3</div>\n        <div class=\"ss-sv-date\">$1 &nbsp;|&nbsp; $2</div>\n      </div>\n      <div class=\"ss-sv-divider\"></div>\n      <div class=\"ss-sv-weather\"><span class=\"ss-sv-icon\">$4</span></div>\n      <div class=\"ss-sv-toggle\">▼</div>\n    </div>\n</label>\n  <div class=\"ss-sv-body\">\n    <div class=\"ss-sv-body-inner\"><div class=\"ss-sv-body-pad\">\n      <div><div class=\"ss-sv-label\">⚔ Conflict</div><div class=\"ss-sv-conflict\">$6</div></div>\n      <div><div class=\"ss-sv-label\">👤 Characters</div><div class=\"ss-sv-chars\">$7</div></div>\n      <div><div class=\"ss-sv-label\">🔍 Detail</div><div class=\"ss-sv-detail\">$8</div></div>\n      <div><div class=\"ss-sv-label\">📜 Plot</div><div class=\"ss-sv-plot\">$9</div></div>\n      <div><div class=\"ss-sv-label\">➡ Next</div><div class=\"ss-sv-next\">$10</div></div>\n    </div>\n    </div>\n  </div>\n</div>",
